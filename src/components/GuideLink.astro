---
interface Props {
  title: string;
  desc: string;
  href: string;
  badge?: string;
  status?: "live" | "soon";
}

const { title, desc, href, badge, status = "live" } = Astro.props;
---

<a class="card guide-card" href={href}>
  <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.35rem">
    {badge && <span class="tag">{badge}</span>}
    {status === "soon" && <span class="tag" style="color:var(--bad)">Coming soon</span>}
  </div>
  <h3 style="margin:0 0 0.25rem">{title}</h3>
  <p class="muted" style="margin:0;font-size:0.92rem">{desc}</p>
</a>

<style>
  .guide-card {
    display: block;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .guide-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
</style>
