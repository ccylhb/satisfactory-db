---
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import items from "../data/satisfactory_items.json";
import buildings from "../data/satisfactory_buildings.json";

const n = (v: any) => {
  const m = String(v ?? "").match(/-?\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : 0;
};
const defPerMin = (x: any) => {
  const best = x.recipes?.find((rc: any) => !rc.alternate) || x.recipes?.[0];
  if (!best?.craft_time || !best?.product_count) return 0;
  return Math.round((60 / best.craft_time) * best.product_count * 10) / 10;
};
const fastest = items
  .filter((x: any) => x.recipes?.length)
  .map((x: any) => ({ ...x, perMin: defPerMin(x) }))
  .sort((a: any, b: any) => b.perMin - a.perMin)
  .slice(0, 12);
const mostRecipes = items
  .filter((x: any) => x.recipes?.length)
  .sort((a: any, b: any) => b.recipes.length - a.recipes.length)
  .slice(0, 10);
const biggestBatch = items
  .flatMap((x: any) => (x.recipes || []).map((rc: any) => ({ ...rc, item: x.title, slug: x.slug })))
  .sort((a: any, b: any) => (b.product_count || 0) - (a.product_count || 0))
  .slice(0, 10);
const mostInputs = items
  .flatMap((x: any) => (x.recipes || []).map((rc: any) => ({ ...rc, item: x.title, slug: x.slug })))
  .sort((a: any, b: any) => b.ingredients.length - a.ingredients.length)
  .slice(0, 10);
const powerHungry = buildings
  .map((x: any) => ({ ...x, power: n(x.fields?.powerusage) }))
  .filter((x: any) => x.power > 0)
  .sort((a: any, b: any) => b.power - a.power)
  .slice(0, 10);
---
<Base
  title="Satisfactory Rankings — fastest recipes, biggest batches & most power hungry"
  description="Satisfactory leaderboards: fastest default production per minute, items with most recipes, biggest single-craft batches, most complex recipes and most power-hungry machines."
>
  <h1>Rankings</h1>
  <p class="muted">Leaderboards computed from full recipe data. Click any entry for details.</p>

  <div class="grid grid-2" style="margin:1.25rem 0">
    <div class="card">
      <h2 style="margin-top:0">⚡ Fastest per minute (default recipe)</h2>
      <ol class="rank-list">
        {fastest.map((x: any) => (
          <li>
            <a href={`/items/${x.slug}/`}>{x.title}</a>
            {x.icon_file && <img src={`/icons/${x.icon_file}`} alt="" width="20" height="20" style="vertical-align:middle" loading="lazy" />}
            <span class="muted"> — {x.perMin}/min</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="card">
      <h2 style="margin-top:0">🔁 Most recipes (incl. alternates)</h2>
      <ol class="rank-list">
        {mostRecipes.map((x: any) => (
          <li>
            <a href={`/items/${x.slug}/`}>{x.title}</a>
            <span class="muted"> — {x.recipes.length} recipes</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="card">
      <h2 style="margin-top:0">📦 Biggest single-craft batch</h2>
      <ol class="rank-list">
        {biggestBatch.map((rc: any) => (
          <li>
            <a href={`/items/${rc.slug}/`}>{rc.item}</a>
            <span class="muted"> — {rc.product_count}× per {rc.craft_time}s ({rc.name})</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="card">
      <h2 style="margin-top:0">🧩 Most complex recipes</h2>
      <ol class="rank-list">
        {mostInputs.map((rc: any) => (
          <li>
            <a href={`/items/${rc.slug}/`}>{rc.item}</a>
            <span class="muted"> — {rc.ingredients.length} inputs ({rc.name})</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="card" style="margin:1.25rem 0">
    <h2 style="margin-top:0">🔌 Most power-hungry machines</h2>
    <ol class="rank-list">
      {powerHungry.map((b: any) => (
        <li>
          <a href={`/buildings/${b.slug}/`}>{b.title}</a>
          <span class="muted"> — {b.power} MW</span>
        </li>
      ))}
    </ol>
  </div>

  <Related
    links={[
      { href: "/production-calculator/", title: "Production Calculator", sub: "Per-minute rates", tool: true },
      { href: "/items/", title: "Items", sub: "All recipes" },
      { href: "/buildings/", title: "Buildings", sub: "Machines & power" },
    ]}
  />
</Base>

<style>
  .rank-list { margin: 0; padding-left: 1.3rem; line-height: 1.9; }
  .rank-list img { margin-left: 0.3rem; }
</style>
