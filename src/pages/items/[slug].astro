---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import items from "../../data/satisfactory_items.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";

export function getStaticPaths() {
  return items.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const f = x.fields || {};
const fmtRate = (count, time) => {
  const c = parseFloat(count);
  const t = parseFloat(time);
  if (!c || !t) return "";
  return String(Math.round((60 / t) * c * 10) / 10);
};
const recipes = (x.recipes || []).map((rc) => ({
  ...rc,
  perMin: fmtRate(rc.product_count, rc.craft_time),
}));
const similar = items
  .filter((o) => o.slug !== x.slug && (o.fields?.category || "") === (f.category || ""))
  .slice(0, 6);
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://satisfactory-db.pages.dev/" },
      { "@type": "ListItem", position: 2, name: "Items", item: "https://satisfactory-db.pages.dev/items/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: "https://satisfactory-db.pages.dev" + "/items/" + __slug + "/",
  },
];
---
<Base
  title={`${x.title} — Satisfactory recipe & production rates`}
  description={`${x.title}: ${recipes.length} recipes${f.stackSize ? `, stack ${f.stackSize}` : ""}${f.researchTier ? `, ${f.researchTier}` : ""} — Satisfactory crafting recipes with per-minute rates.`}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  {f.description && <p class="muted">{f.description}</p>}
  <p>
    {f.category && <span class="tag" style="margin:0.1rem">{f.category}</span>}
    {f.stackSize && <span class="tag" style="margin:0.1rem">Stack {f.stackSize}</span>}
    {f.researchTier && <span class="tag" style="margin:0.1rem">{f.researchTier}</span>}
  </p>
  {ihtml && <p set:html={ihtml}></p>}

  {recipes.length > 0 && <h2>Recipes ({recipes.length})</h2>}
  {recipes.map((rc) => (
    <div class="card" style="margin:0.75rem 0">
      <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem">
        <strong>{rc.name || x.title}{rc.alternate && <span class="tag" style="margin-left:0.5rem">Alternate</span>}</strong>
        <span class="muted">{rc.tier}</span>
      </div>
      <p style="margin:0.4rem 0">
        <strong>{rc.crafted_in}</strong> · {rc.craft_time}s craft →
        <strong> {rc.product_count}× {rc.product || x.title}</strong>
        {rc.perMin && <span class="muted"> ({rc.perMin}/min)</span>}
      </p>
      <p style="margin:0.2rem 0">
        {rc.ingredients.map((ing) => (
          <span class="tag" style="margin:0.1rem">{ing.qty}× {ing.name}</span>
        ))}
      </p>
    </div>
  ))}

  <Related
    links={[
      ...similar.map((s) => ({
        href: `/items/${s.slug}/`,
        title: s.title,
        sub: `${s.recipes ? s.recipes.length : 0} recipes`,
        icon: s.icon_file ? `/icons/${s.icon_file}` : undefined,
      })),
      { href: "/items/", title: "All Items", sub: "Sortable rates table" },
      { href: "/production-calculator/", title: "Production Calculator", sub: "Per-minute rates", tool: true },
    
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
