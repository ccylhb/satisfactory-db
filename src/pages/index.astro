---
const SITE = Astro.site?.origin ?? "";
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import updates from "../data/updates.json";

import items from "../data/satisfactory_items.json";
import buildings from "../data/satisfactory_buildings.json";

const total = items.length + buildings.length;
const n = (v: any) => {
  const m = String(v ?? "").match(/-?\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : 0;
};
const defPerMin = (x: any) => {
  const best = x.recipes?.find((rc: any) => !rc.alternate) || x.recipes?.[0];
  if (!best?.craft_time || !best?.product_count) return 0;
  return Math.round((60 / best.craft_time) * best.product_count * 10) / 10;
};
const withAlt = items.filter((x: any) => x.recipes?.some((rc: any) => rc.alternate));
const bestItem = items
  .filter((x: any) => x.recipes?.length)
  .map((x: any) => ({ ...x, perMin: defPerMin(x) }))
  .sort((a: any, b: any) => b.perMin - a.perMin)[0];
const __ld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SatisfactoryDB",
  url: SITE + "/",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: SITE + "/search/?q={search_term_string}" },
    "query-input": "required name=search_term_string",
  },
};

---
<Base title="SatisfactoryDB — Satisfactory recipes, machines & production rates" description={`Satisfactory stats database: ${total} entries — crafting recipes with per-minute rates, alternate recipes, machines, buildings and power usage with a production calculator.`}>
  <div style="text-align:center;margin:2.5rem 0 2rem">
    <h1 style="font-size:clamp(2.2rem,6vw,3.4rem)">Build the factory, by the numbers.</h1>
    <p class="muted" style="font-size:1.15rem;max-width:640px;margin:0.75rem auto">
      {total} Satisfactory entries with exact values — every recipe, every alternate, every per-minute rate.
    </p>
    <p style="margin-top:1.5rem">
      <a href="/items/" style="display:inline-block;background:var(--accent);color:var(--bg);font-weight:700;padding:0.7rem 1.4rem;border-radius:10px;margin:0.25rem">Items & recipes</a>
      <a href="/production-calculator/" style="display:inline-block;border:1px solid var(--accent);color:var(--accent);font-weight:700;padding:0.7rem 1.4rem;border-radius:10px;margin:0.25rem">Production Calculator</a>
    </p>
  </div>

  <div class="grid grid-3" style="margin:2rem 0">
    <a class="card" href="/items/" style="color:inherit">
      <div class="stat-num">{items.length}</div>
      <div class="stat-label">Items · recipes</div>
      <p class="muted" style="font-size:0.9rem">Default and alternate recipes with exact per-minute rates.</p>
    </a>
    <a class="card" href="/buildings/" style="color:inherit">
      <div class="stat-num">{buildings.length}</div>
      <div class="stat-label">Buildings · machines</div>
      <p class="muted" style="font-size:0.9rem">Power usage, dimensions and costs for every machine.</p>
    </a>
    <a class="card" href="/items/" style="color:inherit">
      <div class="stat-num">{withAlt.length}</div>
      <div class="stat-label">Items with alternates</div>
      <p class="muted" style="font-size:0.9rem">Every alternate recipe parsed from the wiki, all in one table.</p>
    </a>
  </div>


  <h2>What changed</h2>
  <div class="card updates-card">
    {updates.slice(0, 5).map((u) => (
      <p class="update-line"><span class="dot">●</span> <a href={u.href}>{u.text}</a> <span class="muted">— {u.date}</span></p>
    ))}
  </div>

  <h2>Jump to the answer</h2>
  <div class="card answer-card">
    <ul style="margin:0;padding-left:1.2rem;line-height:2">
      <li>Fastest item: <a href={`/items/${bestItem?.slug}/`}>{bestItem?.title}</a> — {bestItem?.perMin}/min with the default recipe</li>
      <li>Production: <a href="/production-calculator/">Production Calculator</a> — per-minute rates for any recipe</li>
      <li>Power: <a href="/buildings/">{buildings.length} buildings</a> sorted by MW usage</li>
    </ul>
  </div>

  <Related
    heading="All boards"
    links={[
      { href: "/items/", title: "Items", sub: `${items.length} entries` },
      { href: "/buildings/", title: "Buildings", sub: `${buildings.length} entries` },
      { href: "/rankings/", title: "Rankings", sub: "Leaderboards" },
      { href: "/production-calculator/", title: "Production Calculator", sub: "Per-minute rates", tool: true },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
